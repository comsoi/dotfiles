# 历史与缓存
.history
.z
.zsh_history
.bash_history
.zcompdump*
*.zwc

# 编辑器 / IDE
.vscode/
nvim.log

# Shell
.config/starship.toml
.config/bash/custom/
.config/bash/50-custom.bash
.config/fish/fish_variables
.config/zsh/.p10k.zsh
.config/zsh/.custom
.config/zsh/cache/
.config/zsh/.powerlevel10k/
.config/zsh/core/00-init.zsh
.config/zsh/core/00-init-omz.zsh
.config/zsh/core/50-custom.zsh
.config/zsh/plugins/custom/

# 生成文件 / 本地配置
.config/hypr/cache/
.config/hypr/colors.conf
.config/hypr/colors.lua
# noctalia 运行时重新生成，但 hyprland.lua 启动即 require，本地必须存在，只是不入库
.config/hypr/noctalia.lua
.config/hypr/hypridle.conf
.config/hypr/monitors.conf
.config/rofi/colors.rasi
.config/waybar/colors.css
.config/swaync/colors.css
.config/wleave/colors.css
.config/sunsetr/geo.toml
dank-theme.toml

# 应用
.config/scoop/
.config/yazi/plugins/

# zellij：zellij 每次改写 config.kdl 都会自己滚一份 .bak，
# 只收录 config.kdl / layouts / scripts，备份不进仓库
.config/zellij/*.bak*

# Flatpak 导出
.local/share/flatpak/exports/share/applications/
.local/share/flatpak/exports/share/dbus-1/
.local/share/flatpak/exports/share/icons/
.local/share/flatpak/exports/share/metainfo/
