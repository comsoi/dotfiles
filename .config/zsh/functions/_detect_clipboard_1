# https://github.com/ohmyzsh/ohmyzsh/blob/master/lib/clipboard.zsh
emulate -L zsh

if [[ "${OSTYPE}" == darwin* ]] && (( ${+commands[pbcopy]} )) && (( ${+commands[pbpaste]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | pbcopy; }
	function cpaste() { pbpaste; }
elif [[ "${OSTYPE}" == (cygwin|msys)* ]]; then
	function cpcopy() { cat "${1:-/dev/stdin}" > /dev/clipboard; }
	function cpaste() { cat /dev/clipboard; }
elif (( ${+commands[win32yank]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | win32yank -i; }
	function cpaste() { win32yank -o --lf; }
elif (( $+commands[clip.exe] )) && (( $+commands[powershell.exe] )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | clip.exe; }
	function cpaste() { powershell.exe -noprofile -command Get-Clipboard; }
elif [ -n "${WAYLAND_DISPLAY:-}" ] && (( ${+commands[wl-copy]} )) && (( ${+commands[wl-paste]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | wl-copy &>/dev/null &|; }
	function cpaste() { wl-paste --no-newline; }
elif [ -n "${DISPLAY:-}" ] && (( ${+commands[xsel]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | xsel --clipboard --input; }
	function cpaste() { xsel --clipboard --output; }
elif [ -n "${DISPLAY:-}" ] && (( ${+commands[xclip]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | xclip -selection clipboard -in &>/dev/null &|; }
	function cpaste() { xclip -out -selection clipboard; }
elif (( ${+commands[lemonade]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | lemonade copy; }
	function cpaste() { lemonade paste; }
elif (( ${+commands[doitclient]} )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | doitclient wclip; }
	function cpaste() { doitclient wclip -r; }
elif [[ $OSTYPE == linux-android* ]] && (( $+commands[termux-clipboard-set] )); then
	function cpcopy() { cat "${1:-/dev/stdin}" | termux-clipboard-set; }
	function cpaste() { termux-clipboard-get; }
elif [ -n "${TMUX:-}" ] && (( ${+commands[tmux]} )); then
	function cpcopy() { tmux load-buffer "${1:--}"; }
	function cpaste() { tmux save-buffer -; }
else
	function _retry_clipboard_detection_or_fail() {
		local clipcmd="${1}"; shift
		if _detect_clipboard; then
			"${clipcmd}" "$@"
		else
			print "${clipcmd}: Platform $OSTYPE not supported or xclip/xsel not installed" >&2
			return 1
		fi
	}
	function cpcopy() { _retry_clipboard_detection_or_fail cpcopy "$@"; }
	function cpaste() { _retry_clipboard_detection_or_fail cpaste "$@"; }
	return 1
fi
