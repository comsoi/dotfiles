# ==============================================================================
# legacy.tmux —— <3.0 兜底（由 tmux.conf 的版本闸门加载）
# 现代功能（插件状态栏/smart-splits/复制模式定制）在这些版本上不可用，
# 通用键位已在 conf/keys/ 中生效，这里只补最小配置。
# ==============================================================================

# 2.1+ 的统一鼠标开关；1.8 上会报一行 "ambiguous option: mouse"，无害
set -gq mouse on

# 没有 catppuccin，给一个朴素的状态栏
set -g status-right '%Y-%m-%d %H:%M '
