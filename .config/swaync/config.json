{
	"$schema": "/etc/xdg/swaync/configSchema.json",
	"ignore-gtk-theme": true,
	"positionX": "right",
	"positionY": "top",
	"layer": "overlay",
	"control-center-layer": "top",
	"layer-shell": true,
	"layer-shell-cover-screen": true,
	"cssPriority": "user",
	"control-center-margin-top": 13,
	"control-center-margin-bottom": 450,
	"control-center-margin-right": 15,
	"control-center-margin-left": 0,
	"notification-2fa-action": true,
	"notification-inline-replies": false,
	"notification-body-image-height": 100,
	"notification-body-image-width": 200,
	"timeout": 10,
	"timeout-low": 5,
	"timeout-critical": 5,
	"fit-to-screen": true,
	"relative-timestamps": true,
	"control-center-width": 420,
	"control-center-height": 680,
	"notification-window-width": 370,
	"keyboard-shortcuts": true,
	"notification-grouping": true,
	"image-visibility": "when-available",
	"transition-time": 200,
	"hide-on-clear": false,
	"hide-on-action": true,
	"text-empty": "No Notifications",
	"script-fail-notify": true,
	"notification-visibility": {
		"example-name": {
			"state": "muted",
			"urgency": "Low",
			"app-name": "Spotify"
		}
	},
	"widgets": [
		"dnd",
		"buttons-grid",
		"mpris",
		"volume",
		"backlight",
		"inhibitors",
		"title",
		"notifications"
	],
	"widget-config": {
		"notifications": {
			"vexpand": true
		},
		"inhibitors": {
			"text": "Inhibitors",
			"button-text": "Clear All",
			"clear-all-button": true
		},
		"title": {
			"text": "Notifications",
			"clear-all-button": true,
			"button-text": "Clear All"
		},
		"dnd": {
			"text": "Do Not Disturb"
		},
		"mpris": {
			"blacklist": [],
			"autohide": false,
			"show-album-art": "always",
			"loop-carousel": false
		},
		"volume": {
			"label": "󰕾",
			"show-per-app-icon": true,
			"show-per-app": true
		},
		"backlight": {
			"label": "󰃠",
			"min": 5
		},
		"buttons-grid": {
			"buttons-per-row": 3,
			"actions": [
				{
					"label": "󰤥",
					"type": "toggle",
					"active": true,
					"command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && nmcli radio wifi on || nmcli radio wifi off'",
					"update-command": "sh -c '[[ $(nmcli radio wifi) == \"enabled\" ]] && echo true || echo false'"
				},
				{
					"label": "󰂯",
					"type": "toggle",
					"active": true,
					"command": "sh -c '[[ $SWAYNC_TOGGLE_STATE == true ]] && bluetoothctl power on || bluetoothctl power off'",
					"update-command": "bluetoothctl show | grep -q 'Powered: yes' && echo true || echo false"
				},
				{
					"label": "",
					"command": "hyprlock"
				},
				{
					"label": "󰝟",
					"type": "toggle",
					"command": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
					"update-command": "pactl get-sink-mute @DEFAULT_SINK@ | grep -q 'yes' && echo true || echo false"
				},
				{
					"label": "",
					"type": "toggle",
					"command": "if [ \"$SWAYNC_TOGGLE_STATE\" = \"true\" ]; then systemctl --user start sunsetr.service ; else systemctl --user stop sunsetr.service ; fi",
					"update-command": "systemctl --user --quiet is-active sunsetr.service && echo true || echo false"
				},
				{
					"label": "",
					"type": "toggle",
					"command": "if [ \"$SWAYNC_TOGGLE_STATE\" = \"false\" ]; then systemctl --user start hypridle.service; else systemctl --user stop hypridle.service; fi",
					"update-command": "systemctl --user --quiet is-active hypridle.service && echo false || echo true"
				}
			]
		}
	}
}
